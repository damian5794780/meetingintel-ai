# Copy to .env at repository root. Never commit real credentials.
TAVILY_API_KEY=
LLM_API_KEY=
# OpenAI-compatible chat completions endpoint; change for your provider.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
# json_schema requires native strict schema support. json_object is an explicit compatibility mode.
LLM_OUTPUT_MODE=json_schema
DATABASE_PATH=data/meetingintel.db
WEB_ORIGIN=http://localhost:3000
MAX_ACTIVE_JOBS=3
JOB_TIMEOUT_SECONDS=120
# Optional provider-specific USD rates per million tokens. Blank = cost unknown.
LLM_INPUT_USD_PER_MILLION=
LLM_OUTPUT_USD_PER_MILLION=
